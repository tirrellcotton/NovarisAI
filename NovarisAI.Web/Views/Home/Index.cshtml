@model NovarisAI.Web.Models.ChatViewModel

@{
    ViewData["Title"] = "Novaris AI";
}

<section class="chat">
    <div class="chat__inner">
        <h1 class="chat__title">Novaris AI</h1>

        <p class="chat__subtitle">
            Local coding assistant powered by Qwen2.5-Coder 7B.
        </p>

        <form asp-action="Index"
              asp-controller="Home"
              method="post"
              class="chat__form">

            <div asp-validation-summary="ModelOnly"
                 class="chat__validation chat__validation--summary">
            </div>

            <div class="chat__field">
                <textarea asp-for="Prompt"
                          class="chat__textarea"
                          rows="8"
                          placeholder="Ask a programming question...">
                </textarea>

                <span asp-validation-for="Prompt"
                      class="chat__validation chat__validation--field">
                </span>
            </div>

            <button type="submit"
                    class="chat__submit">
                Ask Novaris AI
            </button>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.Response))
        {
            <hr class="chat__divider" />
            <h2 class="chat__response-title">Response</h2>
            <pre class="chat__response-box"><code>@Model.Response</code></pre>
        }
    </div>
</section>
