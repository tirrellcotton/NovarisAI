@{
    var supportedThemes = new[] { "light", "dark", "blue" };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="theme-color" content="#f6f7f9" data-theme-color />
    <title>@ViewData["Title"] - Novaris AI</title>
    <link rel="icon" type="image/png" href="~/favicon.png"/>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/icons/icon-192.png" />
    <script type="importmap"></script>
    <script>
        window.novarisThemes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(supportedThemes));

        (() => {
            try {
                const theme = window.localStorage.getItem("novaris-theme");
                const supportedThemes = Array.isArray(window.novarisThemes)
                    ? window.novarisThemes
                    : [];

                if (supportedThemes.includes(theme)) {
                    document.documentElement.dataset.theme = theme;
                }
            } catch {
            }
        })();
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body class="site">
<header class="site__header">
    <nav class="site-nav">
        <div class="site-nav__inner">
            <div class="site-nav__branding">
                <a class="site-nav__brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img class="site-nav__mark" src="~/favicon.png" alt="" aria-hidden="true"/>
                    <span>Novaris AI</span>
                </a>
                <p class="site-nav__tagline">Local intelligence system for fast iteration.</p>
            </div>

            <div class="theme-toggle" role="group" aria-label="Color theme">
                @foreach (var theme in supportedThemes)
                {
                    var themeLabel = char.ToUpperInvariant(theme[0]) + theme[1..];
                    <button type="button" class="theme-toggle__button" data-theme-option="@theme" aria-pressed="false">
                        @themeLabel
                    </button>
                }
            </div>
        </div>
    </nav>
</header>
<aside class="pwa-update" role="status" hidden data-pwa-update>
    <span>A new version of Novaris AI is ready.</span>
    <button type="button" class="pwa-update__button" data-pwa-update-action>Update now</button>
</aside>
<div class="site__content">
    <main role="main" class="site__main">
        @RenderBody()
    </main>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.12.0/highlight.min.js"
        defer
        onload="window.dispatchEvent(new Event('novaris-highlight-ready'))"></script>
<script type="module" src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
