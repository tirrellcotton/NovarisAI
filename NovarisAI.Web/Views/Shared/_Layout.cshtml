<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Novaris AI</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body class="site">
<header class="site__header">
    <nav class="site-nav">
        <div class="site-nav__inner">
            <div class="site-nav__branding">
                <a class="site-nav__brand" asp-area="" asp-controller="Home" asp-action="Index">Novaris AI</a>
                <p class="site-nav__tagline">Local coding assistant for fast iteration.</p>
            </div>

            <div class="theme-toggle" role="group" aria-label="Color theme">
                <button type="button" class="theme-toggle__button" data-theme-option="light" aria-pressed="false">
                    Light
                </button>
                <button type="button" class="theme-toggle__button" data-theme-option="dark" aria-pressed="false">
                    Dark
                </button>
                <button type="button" class="theme-toggle__button" data-theme-option="blue" aria-pressed="false">
                    Blue
                </button>
            </div>
        </div>
    </nav>
</header>
<div class="site__content">
    <main role="main" class="site__main">
        @RenderBody()
    </main>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script type="module" src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
